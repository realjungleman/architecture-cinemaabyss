@startuml
title Кинобездна. С4 уровень контейнеров

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "Пользователь", "Клиент")

Container_Boundary(MainSystem, "Монолит", "Управление стриминговым сервисом"){
    Container(Orchestrator, "Оркестратор микросервисов", "Go", "Управляет микросервисами")
    ContainerDb(Database, "СУБД", "MongoDB", "Хранит профили, список просмотров, платежные данные, телеметрию")
    ContainerQueue(RecommendationSystemQueue, "Очередь рекомендаций", "Kafka", "Принимает сообщения от внешних систем")
    Container(ExternalGate, "Шлюз внешних систем", "Go", "Взаимодействует с протоколами внешних систем")
    Container(OnlineCinemaGate, "Шлюз онлайн кинотеатров", "Go", "Взаимодействует с онлайн-кинотеатрами")
    Container(MainSystemBack, "Основной бэкенд", "Go", "Управляет стриминговым сервисом")
    Container(App, "Интерфейс пользователя", "Python, Django", "Интерфейс приложения")
    Container(PaymentSystemGate, "Сервис оплаты", "Go", "Взаимодействует с платежной системой")
    ContainerDb(S3, "Хранилище видеоданных", "S3", "Хранит видеоданные")
}
SystemQueue(RecommendationSystem, "Рекомендательная система", "Подборки на основе интересов")
SystemQueue(ExternalSystem, "Система интеграций", "Расширители функций стриминга")
System(OnlineCinema, "Внешний онлайн-кинотеатр", "Дает доступ к картотеке видеофайлов")
System(PaymentSystem, "Платежная система", "Проводит платежные транзакции")

Rel(user, App, "")
Rel(App, MainSystemBack, "")
Rel(MainSystemBack, Orchestrator, "")
Rel(Orchestrator, Database, "")
Rel(Orchestrator, OnlineCinemaGate, "")
Rel(Orchestrator, PaymentSystemGate, "")
Rel(Orchestrator, S3, "")

Rel(ExternalGate, RecommendationSystemQueue, "")
Rel(RecommendationSystemQueue, MainSystemBack, "")
Rel(RecommendationSystem, ExternalGate, "")
Rel(ExternalSystem, ExternalGate, "")
Rel(OnlineCinemaGate, OnlineCinema, "")
Rel(PaymentSystemGate, PaymentSystem, "")
@enduml